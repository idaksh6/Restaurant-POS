# Local Postgres (recommended for production — run deploy/cyberpanel/install-postgres.sh on server)
DATABASE_URL=postgresql://mesa:CHANGE_ME@127.0.0.1:5432/mesa?sslmode=disable
# Used to CREATE DATABASE for new tenant companies
DATABASE_ADMIN_URL=postgresql://mesa:CHANGE_ME@127.0.0.1:5432/postgres?sslmode=disable

# Dev (same machine):
# DATABASE_URL=postgresql://mesa:mesa@localhost:5432/mesa
# DATABASE_ADMIN_URL=postgresql://mesa:mesa@localhost:5432/postgres
JWT_SECRET=change-me-in-production
REDIS_URL=redis://localhost:6379
PORT=3001
DEV_PORTAL_USER=developer
DEV_PORTAL_PASSWORD=change-me
# 0 = do not auto-create demo company on boot
SEED_DEMO=0
DELIVERY_WEBHOOK_SECRET=change-me-in-production
