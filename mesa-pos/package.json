{
  "name": "mesa-pos",
  "description": "Mesa KSA Restaurant POS",
  "author": "Mesa",
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:win": "npm run build && electron-builder --win dir --x64 && node electron/make-setup.mjs",
    "desktop:mac": "npm run build && electron-builder --mac dmg",
    "desktop:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "sa.mesa.pos",
    "productName": "Mesa POS",
    "copyright": "Copyright © Mesa",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "!**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "app-ui"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "compression": "store",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "artifactName": "Mesa-POS-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "Mesa-POS-${version}-linux.${ext}"
    }
  }
}
